#!/usr/bin/env bash
# Скачать модель whisper в $VOICEREC_HOME/models (и только туда, никаких ~/.cache).
#   vr-model large-v3-turbo-q5_0 | large-v3-turbo | large-v3 | medium | small | base
#   vr-model silero-v6.2.0   (VAD, лежит в другом репозитории HuggingFace)
# Использовать другую: VR_MODEL_NAME=<name> vr
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../config.sh"

name="${1:?usage: vr-model <name>}"
dest="$VOICEREC_HOME/models/ggml-$name.bin"
case "$name" in
  silero-*) url="https://huggingface.co/ggml-org/whisper-vad/resolve/main/ggml-$name.bin" ;;
  *)        url="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-$name.bin" ;;
esac

mkdir -p "$VOICEREC_HOME/models"
if [ -f "$dest" ]; then
  echo "уже есть: $dest"
  exit 0
fi

# .part + -C -: оборванная загрузка докачивается, а не начинается заново
curl -fL --progress-bar -C - -o "$dest.part" "$url"
mv "$dest.part" "$dest"
echo "$dest"
