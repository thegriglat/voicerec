#!/usr/bin/env bash
# Скачать модель whisper: vr-model small | medium | large-v3 | large-v3-turbo
# Использовать: VR_MODEL=~/voicerec/models/ggml-<name>.bin vr
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../config.sh"

bash "$VOICEREC_HOME/src/models/download-ggml-model.sh" "${1:?usage: vr-model <name>}" "$VOICEREC_HOME/models"
