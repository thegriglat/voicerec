#!/usr/bin/env bash
# Расшифровать аудиофайл любого формата: vr-transcribe file.ogg > text.txt
#   vr-transcribe --meet file.ogg   запись встречи (vr meet): левый канал — микрофон,
#                                   правый — звук компьютера; реплики по времени с метками
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../config.sh"

meet=0
[ "${1:-}" = --meet ] && { meet=1; shift; }
in="${1:?usage: vr-transcribe [--meet] <audio-file>}"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# VAD: паузы на «подумать» вырезаются; pad 200 мс — не обрезать края слов
vad=()
[ "$VR_VAD" = 1 ] && vad=(--vad -vm "$VR_VAD_MODEL" -vp 200)

# $1 — wav, $2 — формат вывода (-otxt, -ocsv), результат в $tmp/out.{txt,csv}
whisper() {
  "$VR_BIN/whisper-cli" -m "$VR_MODEL" "${vad[@]}" -l "$VR_LANG" -t "$VR_THREADS" \
    --prompt "$VR_PROMPT" -np "$2" -of "$tmp/out" -f "$1" >/dev/null 2>"$tmp/log" \
    || { cat "$tmp/log" >&2; exit 1; }
}

# whisper.cpp принимает только 16 kHz mono wav; стерео без --meet сводится в моно
to_wav() {
  ffmpeg -nostdin -loglevel error -y -i "$in" "$@" -ar 16000 -ac 1 -c:a pcm_s16le "$tmp/in.wav"
}

# Сегменты канала: «начало_мс<TAB>конец_мс<TAB>метка<TAB>текст». VAD-таймстемпы
# whisper пересчитывает в исходное время, так что каналы совпадают по времени.
segments() {
  whisper "$tmp/in.wav" -ocsv
  awk -v who="$1" 'NR > 1 && match($0, /^[0-9]+,[0-9]+,"/) {
    split(substr($0, 1, RLENGTH), t, ",")
    text = substr($0, RLENGTH + 1, length($0) - RLENGTH - 1)
    gsub(/""/, "\"", text)
    print t[1] "\t" t[2] "\t" who "\t" text
  }' "$tmp/out.csv"
}

if [ "$meet" = 1 ]; then
  for ch in 0 1; do
    to_wav -af "pan=mono|c0=c$ch"
    label="$VR_MEET_ME"; [ "$ch" = 1 ] && label="$VR_MEET_THEM"
    segments "$label"
  done | python3 "$VOICEREC_HOME/lib/meet-merge.py" "$VR_MEET_ME" "$VR_MEET_THEM" "$VR_MEET_DEDUP"
  exit
fi

to_wav
whisper "$tmp/in.wav" -otxt
# whisper режет текст на сегменты по строкам — склеиваем в абзац
sed 's/^ *//' "$tmp/out.txt" | tr '\n' ' ' | sed 's/  */ /g; s/ $//'
echo
