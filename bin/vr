#!/usr/bin/env bash
# Наговорить текст: запись с микрофона → расшифровка → файл.
#   vr [файл]          запись до Enter/Ctrl+C, затем расшифровка
#   vr toggle [файл]   первый вызов начинает запись, второй — останавливает и расшифровывает
#                      (для горячей клавиши; файл задаётся при старте записи)
# С файлом текст дописывается в его конец отдельным абзацем — ТЗ можно наговаривать
# кусками. Без файла — только recordings/<дата>.txt. Копия каждой записи (wav + txt)
# всегда остаётся в recordings/.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../config.sh"

mkdir -p "$VR_RECORDINGS"
state="${XDG_RUNTIME_DIR:-/tmp}/voicerec"
pidfile="$state.pid"
outfile_state="$state.out"
wavfile="$state.wav"

# exec: вызывается только в фоне (record &), так $! — это сам arecord, а не подоболочка
record() {
  exec arecord -q -D "$VR_DEVICE" -f S16_LE -r 16000 -c 1 "$wavfile"
}

# $1 — файл, в который дописать текст (пусто — только recordings/)
finish() {
  local out="$1" stamp text
  stamp="$(date +%Y-%m-%d_%H-%M-%S)"
  cp "$wavfile" "$VR_RECORDINGS/$stamp.wav"
  text="$("$VOICEREC_HOME/bin/vr-transcribe" "$wavfile")"
  rm -f "$wavfile"
  printf '%s\n' "$text" > "$VR_RECORDINGS/$stamp.txt"
  if [ -n "$out" ]; then
    mkdir -p "$(dirname "$out")"
    # пустая строка между кусками, но не в начале нового файла
    [ -s "$out" ] && printf '\n' >> "$out"
    printf '%s\n' "$text" >> "$out"
  fi
  printf '%s\n' "$text"
}

# Абсолютный путь: toggle может вызываться из другого каталога (горячая клавиша)
abspath() {
  [ -n "$1" ] && realpath -m -- "$1" || true
}

case "${1:-}" in
  toggle)
    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
      kill -TERM "$(cat "$pidfile")"
      # ждём, пока arecord допишет заголовок wav
      while kill -0 "$(cat "$pidfile")" 2>/dev/null; do sleep 0.1; done
      out="$(cat "$outfile_state")"
      rm -f "$pidfile" "$outfile_state"
      notify-send -t 2000 "voicerec" "Расшифровка..."
      text="$(finish "$out")"
      notify-send -t 5000 "voicerec: ${out:-$VR_RECORDINGS}" "$text"
    else
      abspath "${2:-}" > "$outfile_state"
      record & echo $! > "$pidfile"
      notify-send -t 2000 "voicerec" "Запись... (повторите хоткей, чтобы закончить)"
    fi
    ;;
  -h|--help)
    sed -n '2,8p' "$0" ;;
  *)
    out="$(abspath "${1:-}")"
    echo "Запись... Enter или Ctrl+C — закончить" >&2
    record & rec_pid=$!
    trap 'kill -TERM $rec_pid 2>/dev/null' INT
    read -r _ || true
    kill -TERM "$rec_pid" 2>/dev/null || true
    wait "$rec_pid" || true
    trap - INT
    echo "Расшифровка..." >&2
    finish "$out"
    [ -z "$out" ] || echo "(дописано в $out)" >&2
    ;;
esac
