#!/usr/bin/env bash
# Собирает whisper.cpp (сабмодуль src/, версия закреплена в репозитории),
# при отсутствии скачивает модель.
# Бэкенд выбирается сам: CUDA (NVIDIA, есть nvcc) → Vulkan (AMD/Intel, есть glslc) → CPU.
# Обновить whisper.cpp: git submodule update --remote src && vr-build, затем закоммитить src.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/../config.sh"

git -C "$VOICEREC_HOME" submodule update --init --depth 1 src
cd "$VOICEREC_HOME/src"

flags=(-DCMAKE_BUILD_TYPE=Release -DWHISPER_SDL2=ON -DBUILD_SHARED_LIBS=OFF)
if command -v nvcc >/dev/null; then
  echo "backend: CUDA"
  flags+=(-DGGML_CUDA=ON)
elif command -v glslc >/dev/null && [ -e /usr/include/vulkan/vulkan.h ]; then
  echo "backend: Vulkan"
  flags+=(-DGGML_VULKAN=ON)
else
  echo "backend: CPU (нет nvcc и glslc+libvulkan-dev)"
fi

# Смена бэкенда требует чистого кэша cmake
rm -rf build
cmake -B build "${flags[@]}"
cmake --build build -j"$(nproc)" --target whisper-cli whisper-stream

"$VOICEREC_HOME/bin/vr-model" "$VR_MODEL_NAME"
ls -1 build/bin/whisper-cli build/bin/whisper-stream "$VR_MODEL"
